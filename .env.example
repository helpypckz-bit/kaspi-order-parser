MERCHANT_UID=Applecity
INPUT_FILE=orders.xlsx
OUTPUT_FILE=result.xlsx
HEADLESS=true
MAX_WORKERS=5
REQUEST_TIMEOUT=30
RETRY_COUNT=3
STORAGE_STATE_FILE=storage_state.json
GRAPHQL_QUERY_FILE=graphql/get_order_details.graphql
LOG_FILE=logs/parser.log
VERIFY_SSL=true
# SSL_CA_BUNDLE=C:\path\to\corporate-ca.pem
GRAPHQL_ENDPOINT=https://mc.shop.kaspi.kz/mc/facade/graphql?opName=getOrderDetails
GRAPHQL_FALLBACK_ENDPOINT=https://mc.shop.kaspi.kz/mc/facade/graphql
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
